DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SOLVER=greedy
LLM_ENABLED=false
API_PORT=8000
WEB_PORT=5173
MAX_UPLOAD_BYTES=5242880

# Production controls (all optional; empty keeps the open single-operator demo)
# Shared operator token. When set, /api/v1 requires "Authorization: Bearer <value>"
# or "X-API-Key: <value>". Health and auth discovery stay public.
API_TOKEN=
# Comma-separated Host headers to accept (e.g. dispatch.example.com). Empty disables.
ALLOWED_HOSTS=
DOCS_ENABLED=true
SECURITY_HEADERS=true
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Frontend: where the "Sign in" buttons send people.
# Defaults to /login, which now handles both the Firebase placeholder and the
# operator-token gate. Set this only to hand off to a hosted auth route.
VITE_LOGIN_URL=
